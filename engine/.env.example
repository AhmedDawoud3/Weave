# Weave Engine Configuration

# The API key required to access the Weave Engine endpoints (when auth is enabled).
# Default: weave-default-key-12345
WEAVE_ENGINE_API_KEY=weave-default-key-12345

# Whether to disable API key authentication (useful for local development).
# Set to 'true' to disable auth checks, or 'false' to enforce them.
WEAVE_ENGINE_DISABLE_AUTH=false
