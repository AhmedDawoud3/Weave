#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# post-commit hook
# Runs black + isort on every Python file touched by the most recent commit,
# then amends the commit if any formatting changed.
#
# NOTE: post-commit runs AFTER the commit is recorded.  If formatting changes
# are detected the commit is automatically amended (--no-verify so this hook
# does not trigger itself recursively).
# ---------------------------------------------------------------------------

set -euo pipefail

# ── helpers ────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

info()    { echo -e "${GREEN}[post-commit]${NC} $*"; }
warning() { echo -e "${YELLOW}[post-commit]${NC} $*"; }
error()   { echo -e "${RED}[post-commit]${NC} $*" >&2; }

# ── collect Python files changed in the last commit (engine/ only) ─────────
PYTHON_FILES=$(git diff-tree --no-commit-id -r --name-only HEAD \
    | grep '^engine/.*\.py$' || true)

if [[ -z "$PYTHON_FILES" ]]; then
    info "No Python files in engine/ in this commit – skipping formatter."
    exit 0
fi

info "Formatting Python files from last commit…"

# ── verify that the tools are available ───────────────────────────────────
for tool in isort black; do
    if ! command -v "$tool" &>/dev/null; then
        warning "$tool not found – skipping post-commit formatting."
        warning "Install with: pip install black isort"
        exit 0
    fi
done

# ── run isort then black ─────────────────────────────────────────────────
# shellcheck disable=SC2086
echo "$PYTHON_FILES" | xargs isort --profile black --
# shellcheck disable=SC2086
echo "$PYTHON_FILES" | xargs black --quiet --

# ── amend if any file changed ────────────────────────────────────────────
CHANGED=$(git diff --name-only -- $(echo "$PYTHON_FILES") || true)

if [[ -n "$CHANGED" ]]; then
    info "Formatting changes detected – amending commit…"
    # Stage only the formatted Python files
    # shellcheck disable=SC2086
    git add -- $CHANGED
    git commit --amend --no-edit --no-verify
    info "Commit amended with formatted code."
else
    info "All Python files were already formatted."
fi
